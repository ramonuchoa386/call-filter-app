<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Switch
        android:id="@+id/switchBlockUnknown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rejeitar chamadas de não contatos" />

    <EditText
        android:id="@+id/edtPhoneNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Número para lista de exceção"
        android:inputType="phone"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/btnBlockNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bloquear Contato Específico" />

    <Button
        android:id="@+id/btnUnblockNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Desbloquear Contato Específico" />

</LinearLayout>